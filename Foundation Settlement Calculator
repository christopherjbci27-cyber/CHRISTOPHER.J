#include <stdio.h>
#include <math.h>

int main() {
    float H, Cc, e0, sigma_initial, delta_sigma, settlement;

    printf("--- Clay Consolidation Settlement Analysis ---\n");

    // 1. Input Soil and Loading Parameters
    printf("Enter Thickness of Clay Layer (H) in meters: ");
    scanf("%f", &H);
    printf("Enter Compression Index (Cc): ");
    scanf("%f", &Cc);
    printf("Enter Initial Void Ratio (e0): ");
    scanf("%f", &e0);
    printf("Enter Initial Effective Stress (P0) in kN/m2: ");
    scanf("%f", &sigma_initial);
    printf("Enter Increase in Stress (dP) in kN/m2: ");
    scanf("%f", &delta_sigma);

    /* 
       2. Settlement Formula:
       S = [ (Cc * H) / (1 + e0) ] * log10( (P0 + dP) / P0 )
    */
    settlement = ((Cc * H) / (1 + e0)) * log10((sigma_initial + delta_sigma) / sigma_initial);

    // 3. Output Results
    printf("\n--- Result ---\n");
    printf("Predicted Total Settlement: %.4f meters\n", settlement);
    printf("Predicted Total Settlement: %.2f mm\n", settlement * 1000.0);
    printf("------------------------------\n");

    return 0;
}
