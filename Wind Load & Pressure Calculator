#include <stdio.h>
#include <math.h>

int main() {
    float vb, k1, k2, k3, vz, pz;

    printf("--- Design Wind Pressure Analysis ---\n");

    // 1. Input Wind Parameters (Based on IS 875 Part 3)
    printf("Enter Basic Wind Speed (Vb) in m/s: ");
    scanf("%f", &vb);
    printf("Enter Probability Factor (k1) [Std = 1.0]: ");
    scanf("%f", &k1);
    printf("Enter Terrain/Height Factor (k2): ");
    scanf("%f", &k2);
    printf("Enter Topography Factor (k3) [Std = 1.0]: ");
    scanf("%f", &k3);

    /* 
       2. Calculations
       Design Wind Speed (Vz) = Vb * k1 * k2 * k3
       Design Wind Pressure (Pz) = 0.6 * (Vz^2)
    */
    vz = vb * k1 * k2 * k3;
    pz = 0.6 * (vz * vz);

    // 3. Output Results
    printf("\n--- Design Results ---\n");
    printf("Design Wind Speed (Vz)   : %.2f m/s\n", vz);
    printf("Design Wind Pressure (Pz): %.2f N/m2\n", pz);
    printf("Design Wind Pressure (Pz): %.3f kN/m2\n", pz / 1000.0);
    printf("---------------------------\n");

    return 0;
}
