#include <stdio.h>
#include <math.h>
void analyze_beam() {
    float width, depth, stress;
    float inertia, z_modulus, moment_capacity;
    printf("\n--- Rectangular Beam Analysis ---\n");
    printf("Enter width (b) in mm: ");
    if(scanf("%f", &width) != 1) return;
    printf("Enter depth (d) in mm: ");
    if(scanf("%f", &depth) != 1) return;
    printf("Enter allowable bending stress (N/mm^2): ");
    if(scanf("%f", &stress) != 1) return;
    inertia = (width * pow(depth, 3)) / 12.0;
    z_modulus = inertia / (depth / 2.0);
    moment_capacity = (stress * z_modulus) / 1000000.0;
    printf("\n>> Results <<\n");
    printf("Moment of Inertia: %.2f mm^4\n", inertia);
    printf("Section Modulus:   %.2f mm^3\n", z_modulus);
    printf("Moment Capacity:   %.2f kNm\n", moment_capacity);
    if (moment_capacity < 10.0) {
        printf("Note: Light-duty section.\n");
    } else {
        printf("Note: Heavy-duty section.\n");
    }
}

int main() {
    int run_again = 1;
    
    while (run_again == 1) {
        analyze_beam();
        printf("\nCalculate another? (1=Yes, 0=Exit): ");
        scanf("%d", &run_again);
    }

    printf("Program closed.\n");
    return 0;
}
