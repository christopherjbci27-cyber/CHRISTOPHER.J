#include <stdio.h>

int main() {
    float bulk_density, water_content, dry_density;
    float mold_volume, weight_soil;

    printf("--- Standard Proctor Test Analysis ---\n");

    // 1. Input Laboratory Data
    printf("Enter Volume of Mold (cm3) [Standard is 944]: ");
    scanf("%f", &mold_volume);
    
    printf("Enter Weight of Compacted Soil (grams): ");
    scanf("%f", &weight_soil);
    
    printf("Enter Water Content (in %%, e.g., 12.5): ");
    scanf("%f", &water_content);

    /* 
       2. Calculations
       Bulk Density = Mass / Volume
       Dry Density = Bulk Density / (1 + (Water Content / 100))
    */
    bulk_density = weight_soil / mold_volume;
    dry_density = bulk_density / (1 + (water_content / 100.0));

    // 3. Output Results
    printf("\n--- Resulting Densities ---\n");
    printf("Bulk Density (gm/cm3): %.3f\n", bulk_density);
    printf("Dry Density  (gm/cm3): %.3f\n", dry_density);
    printf("Dry Density  (kg/m3) : %.1f\n", dry_density * 1000.0);
    printf("---------------------------\n");

    return 0;
}
