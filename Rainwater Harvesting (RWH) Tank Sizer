#include <stdio.h>

int main() {
    float area, rainfall, runoff_coeff, months, tank_vol;

    printf("--- Rainwater Harvesting Estimator ---\n");

    // 1. Input Catchment and Climate Data
    printf("Enter Roof Catchment Area (m2): ");
    scanf("%f", &area);
    printf("Enter Annual Average Rainfall (mm): ");
    scanf("%f", &rainfall);
    printf("Enter Runoff Coefficient [e.g., 0.85 for Concrete, 0.95 for Metal]: ");
    scanf("%f", &runoff_coeff);
    printf("Number of dry months to provide storage for: ");
    scanf("%f", &months);

    /* 
       2. Calculations
       Annual Harvest (Liters) = Area * (Rainfall/1000) * Runoff * 1000
       Simplified: Area * Rainfall * Runoff
       Monthly storage: (Annual Harvest / 12) * Dry Months
    */
    float annual_harvest = area * rainfall * runoff_coeff;
    tank_vol = (annual_harvest / 12.0) * months;

    // 3. Output Results
    printf("\n--- Sustainability Report ---\n");
    printf("Total Annual Water Potential : %.2f Liters\n", annual_harvest);
    printf("Recommended Tank Capacity    : %.2f Liters\n", tank_vol);
    printf("Tank Volume in Cubic Meters  : %.2f m3\n", tank_vol / 1000.0);
    printf("------------------------------\n");

    return 0;
}
